{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graphori benchmark raw result",
  "type": "object",
  "required": ["schema_version", "run_id", "arm", "provider", "repetition", "task_id", "started_at", "finished_at", "command", "outcome", "usage", "quality", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "arm": {"enum": ["direct", "v1-style", "graphori-v2"]},
    "provider": {"enum": ["codex", "claude"]},
    "repetition": {"type": "integer", "minimum": 1},
    "task_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "command": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "outcome": {"enum": ["succeeded", "failed", "blocked", "unknown"]},
    "usage": {"type": "object", "properties": {
      "ai_sessions": {"type": ["integer", "null"], "minimum": 0},
      "total_input_tokens": {"type": ["integer", "null"], "minimum": 0},
      "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
      "fresh_input_tokens": {"type": ["integer", "null"], "minimum": 0},
      "output_tokens": {"type": ["integer", "null"], "minimum": 0},
      "cost_usd": {"type": ["number", "null"], "minimum": 0}
    }, "additionalProperties": false},
    "quality": {"type": "object", "properties": {
      "hidden_tests_passed": {"type": ["integer", "null"], "minimum": 0},
      "hidden_tests_total": {"type": ["integer", "null"], "minimum": 0},
      "ttur_seconds": {"type": ["number", "null"], "minimum": 0},
      "rework_count": {"type": ["integer", "null"], "minimum": 0},
      "scope_violations": {"type": ["integer", "null"], "minimum": 0}
    }, "additionalProperties": false},
    "evidence": {"type": "object", "required": ["exit_code"], "properties": {"exit_code": {"type": ["integer", "null"]}, "stdout_sha256": {"type": "string"}, "stderr_sha256": {"type": "string"}}},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
